# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is bundled into
# browser JavaScript, so only put publishable values here, never secrets.

# Required for claim links and analytics.
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Recommended. https://cloud.walletconnect.com (a shared fallback ID is used if unset).
NEXT_PUBLIC_WALLETCONNECT_ID=


# Optional. "mainnet" targets Injective mainnet; unset means testnet.
NEXT_PUBLIC_INJECTIVE_NETWORK=

# Optional. Premium provider endpoints. Unset means Injective's shared public
# endpoints, which Injective does not recommend for production traffic.
# A provider sees users' IP and wallet addresses: check the data-processing terms first.
NEXT_PUBLIC_INJECTIVE_GRPC=
NEXT_PUBLIC_INJECTIVE_REST=
NEXT_PUBLIC_INJECTIVE_INDEXER=
NEXT_PUBLIC_INJECTIVE_EXPLORER=
# A keyless EVM RPC URL, or /api/evm-rpc to go through the server proxy.
NEXT_PUBLIC_INJECTIVE_EVM_RPC=
# A keyless EVM WebSocket URL (wss://) for live payment updates. It is used in
# the browser, so it must not carry a key.
NEXT_PUBLIC_INJECTIVE_EVM_WS=

# Server-only (no NEXT_PUBLIC_ prefix): premium EVM RPC URL including its key,
# used by app/api/evm-rpc. Never prefix this with NEXT_PUBLIC_.
INJECTIVE_EVM_RPC_URL=
